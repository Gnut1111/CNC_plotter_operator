<!doctype html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Pixel2Plot Operator — Điều khiển máy vẽ CNC</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <!-- Auth View (Dub.co Split-Screen 50/50 Light-first) -->
  <section id="loginView" class="login hidden">
    <div class="login-split">
      <!-- Left Column: Clean Unboxed Form (50% Desktop, 100% Mobile) -->
      <div class="login-pane-form">
        <div class="login-grid-pattern" aria-hidden="true"></div>
        <div class="login-form-wrapper">
          <form id="loginForm" class="login-form-clean">
            <div class="login-brand-header">
              <div class="brand-glyph-clean" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#171717" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
                  <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
                  <circle cx="11" cy="11" r="2"></circle>
                </svg>
              </div>
              <div class="brand-heading">
                <h1>Đăng nhập vào Pixel2Plot</h1>
                <p class="muted">Hệ thống điều khiển máy vẽ CNC</p>
              </div>
            </div>
            <div class="login-fields">
              <label>Tên đăng nhập
                <input name="username" autocomplete="username" placeholder="Tên đăng nhập" required />
              </label>
              <label>Mật khẩu
                <input name="password" type="password" autocomplete="current-password" placeholder="Mật khẩu" required />
              </label>
            </div>
            <button class="primary login-submit" type="submit">Đăng nhập</button>
            <p id="loginError" class="error" role="alert"></p>
            <div class="login-quick-box">
              <span class="quick-title muted">Tài khoản mẫu:</span>
              <div class="quick-row">
                <button type="button" class="quick-btn" data-fill="admin:admin123">
                  <span class="quick-user">admin</span><span class="quick-sep">/</span><span class="quick-pass">admin123</span>
                </button>
                <button type="button" class="quick-btn" data-fill="user:user123">
                  <span class="quick-user">user</span><span class="quick-sep">/</span><span class="quick-pass">user123</span>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Right Column: Dub.co CNC Showcase Pane (50% Desktop, Hidden on Mobile) -->
      <div class="login-pane-showcase" aria-hidden="true">
        <div class="showcase-tray-outer">
          <div class="showcase-card-inner">
            <div class="showcase-top">
              <div class="showcase-window-dots">
                <span class="dot-red"></span>
                <span class="dot-yellow"></span>
                <span class="dot-green"></span>
              </div>
              <span class="showcase-chip-title">Raster → Vector → G-code</span>
              <span class="showcase-chip-pill">Simulator Ready</span>
            </div>
            <div class="showcase-svg-wrap">
              <svg viewBox="0 0 420 250" width="100%" height="250" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <pattern id="plotterGrid" width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(0,0,0,0.04)" stroke-width="1"/>
                  </pattern>
                </defs>
                <rect width="420" height="250" fill="url(#plotterGrid)" />
                <!-- Machine Limits / Coordinate Frame -->
                <rect x="25" y="25" width="370" height="200" rx="6" stroke="rgba(0,0,0,0.12)" stroke-width="1.2" stroke-dasharray="4 4" fill="rgba(255,255,255,0.7)" />
                <!-- Origin Marker -->
                <circle cx="25" cy="25" r="4" fill="#171717" />
                <text x="35" y="30" font-family="'JetBrains Mono', monospace" font-size="10" font-weight="600" fill="#71717A">G28 (0,0)</text>
                
                <!-- Corner ticks -->
                <path d="M 390 25 L 395 25 L 395 30" stroke="#71717A" stroke-width="1.5" fill="none"/>
                <path d="M 25 220 L 25 225 L 30 225" stroke="#71717A" stroke-width="1.5" fill="none"/>
                <path d="M 395 220 L 395 225 L 390 225" stroke="#71717A" stroke-width="1.5" fill="none"/>

                <!-- Rapid Travel lines (dotted orange #F97316) -->
                <path d="M 25 25 L 90 75" stroke="#F97316" stroke-width="1.5" stroke-dasharray="3 3" />
                <path d="M 215 165 L 260 85" stroke="#F97316" stroke-width="1.5" stroke-dasharray="3 3" />
                
                <!-- Drawing vector paths (crisp black #171717) -->
                <path d="M 90 75 C 130 40, 175 40, 215 75 C 245 110, 185 165, 90 75 Z" stroke="#171717" stroke-width="2.5" stroke-linejoin="round" fill="none"/>
                <path d="M 260 85 Q 350 75 360 140 T 290 190 T 260 85" stroke="#171717" stroke-width="2.5" stroke-linejoin="round" fill="none"/>
                
                <!-- Hatching internal strokes -->
                <line x1="110" y1="80" x2="195" y2="80" stroke="#171717" stroke-width="1.2" stroke-opacity="0.35" />
                <line x1="120" y1="95" x2="185" y2="95" stroke="#171717" stroke-width="1.2" stroke-opacity="0.35" />
                <line x1="130" y1="110" x2="175" y2="110" stroke="#171717" stroke-width="1.2" stroke-opacity="0.35" />

                <!-- Toolhead Pen Indicator -->
                <circle cx="290" cy="190" r="6" fill="#171717" />
                <circle cx="290" cy="190" r="12" stroke="#171717" stroke-width="1.2" stroke-dasharray="2 2" />
                <rect x="308" y="180" width="85" height="20" rx="4" fill="#171717" />
                <text x="314" y="194" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="600" fill="#FFFFFF">G1 DRAWING</text>
              </svg>
            </div>
            <div class="showcase-bottom-bar">
              <div class="showcase-stat">
                <span class="stat-k">WORKSPACE</span>
                <span class="stat-v">200 × 200 mm</span>
              </div>
              <div class="showcase-stat">
                <span class="stat-k">FEEDRATE</span>
                <span class="stat-v">1500 mm/min</span>
              </div>
              <div class="showcase-stat">
                <span class="stat-k">DISPATCH</span>
                <span class="stat-v stat-green">MQTT / Ready</span>
              </div>
            </div>
          </div>
        </div>
        <div class="showcase-features-row">
          <span>120×80 / 200×200 mm</span>
          <span class="feat-sep">·</span>
          <span>SHA-256 Verified</span>
          <span class="feat-sep">·</span>
          <span>MQTT Realtime</span>
          <span class="feat-sep">·</span>
          <span>Auto-Tune IoU</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main App View -->
  <section id="appView" class="hidden">
    <!-- Topbar on Mobile / Left Sidebar on Desktop (228px Dub.co) -->
    <header class="topbar">
      <div class="topbar-row-primary">
        <div class="topbar-brand">
          <div class="brand-glyph-sm" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
              <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
              <circle cx="11" cy="11" r="2"></circle>
            </svg>
          </div>
          <span class="brand-logo">Pixel2Plot</span>
          <span class="brand-tag">Operator</span>
        </div>
        <div class="topbar-status-mobile">
          <span id="wsDotMobile" class="connection" title="Trạng thái kết nối WebSocket">
            <span class="dot" aria-hidden="true"></span>
          </span>
        </div>
      </div>
      <div class="topbar-row-nav">
        <nav id="tabs" aria-label="Điều hướng chính">
          <button data-tab="draw" class="active">
            <svg class="tab-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
              <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
              <circle cx="11" cy="11" r="2"></circle>
            </svg>
            <span>Vẽ mới</span>
          </button>
          <button data-tab="jobs">
            <svg class="tab-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            <span>Phiên vẽ</span>
          </button>
          <button data-tab="machines">
            <svg class="tab-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
            <span>Máy vẽ</span>
          </button>
          <button data-tab="admin" class="admin-only">
            <svg class="tab-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>Quản trị</span>
          </button>
        </nav>
      </div>
      <div class="topbar-status">
        <span id="wsDot" class="connection" title="Trạng thái kết nối WebSocket">
          <span class="dot" aria-hidden="true"></span>
          <span id="wsLabel">Đang kết nối</span>
        </span>
        <div class="user-pill">
          <span class="user-avatar-dot" id="userAvatar" aria-hidden="true">U</span>
          <span id="whoami" class="user-name"></span>
        </div>
        <button id="logoutBtn" class="small ghost">Đăng xuất</button>
      </div>
    </header>

    <main>
      <!-- Tab 1: Drawing Workspace -->
      <div id="tab-draw" class="tab">
        <!-- Workflow Guide Bar (Slim 32px Dub Stepper) -->
        <nav class="workflow-stepper" aria-label="Quy trình vận hành">
          <div class="step-badge active" id="stepIndicator1">
            <span class="step-num">1</span>
            <span class="step-text">Chọn ảnh</span>
          </div>
          <span class="step-sep" aria-hidden="true">/</span>
          <div class="step-badge" id="stepIndicator2">
            <span class="step-num">2</span>
            <span class="step-text">Xem đường vẽ</span>
          </div>
          <span class="step-sep" aria-hidden="true">/</span>
          <div class="step-badge" id="stepIndicator3">
            <span class="step-num">3</span>
            <span class="step-text">Chọn máy &amp; gửi</span>
          </div>
          <span class="step-sep" aria-hidden="true">/</span>
          <div class="step-badge" id="stepIndicator4">
            <span class="step-num">4</span>
            <span class="step-text">Theo dõi phiên</span>
          </div>
        </nav>

        <div class="grid-draw">
          <!-- Main Left Column: Preview Viewport -->
          <section class="draw-viewport card" aria-label="Xem trước bản vẽ">
            <div class="viewport-header">
              <div class="source-picker">
                <input id="sourceFile" class="visually-hidden" type="file" form="convertForm" name="image" accept="image/png,image/jpeg" aria-describedby="fileInfo" />
                <label for="sourceFile" class="file-button" id="fileBtnLabel">Chọn ảnh</label>
                <span id="fileInfo" class="file-info-text">PNG hoặc JPG · tối đa 5 MB</span>
              </div>
              <div class="viewport-controls">
                <div class="segmented" role="group" aria-label="Chế độ xem">
                  <button type="button" id="pathsView" aria-pressed="true" disabled>Đường vẽ</button>
                  <button type="button" id="imageView" aria-pressed="false" disabled>Ảnh gốc</button>
                  <button type="button" id="compareView" aria-pressed="false" disabled>So nét</button>
                </div>
                <label class="check travel-toggle">
                  <input type="checkbox" id="showTravel" disabled />
                  <span>Đường nhấc bút</span>
                </label>
                <button type="button" id="simulateBtn" class="small" aria-expanded="false" aria-controls="playbackControls" disabled>Mô phỏng</button>
              </div>
            </div>

            <p id="fileError" class="error banner-error" role="alert" hidden></p>

            <!-- Canvas Viewport with Blueprint Matched Recess & Micro-Graphics -->
            <div class="preview-wrap" id="dropZone" tabindex="0" role="region" aria-label="Bàn vẽ">
              <span class="corner-cross cross-tl" aria-hidden="true">+</span>
              <span class="corner-cross cross-tr" aria-hidden="true">+</span>
              <span class="corner-cross cross-bl" aria-hidden="true">+</span>
              <span class="corner-cross cross-br" aria-hidden="true">+</span>
              <canvas id="preview" aria-label="Bản xem trước theo tọa độ máy"></canvas>
              <div id="emptyPreview" class="empty-state">
                <div class="empty-halo-rings" aria-hidden="true"></div>
                <div class="empty-glyph" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </div>
                <h3>Chưa có ảnh đầu vào</h3>
                <p>Chọn hoặc kéo thả ảnh PNG/JPG để tạo đường vẽ.</p>
              </div>
            </div>

            <div id="playbackControls" class="playback-controls" hidden>
              <button type="button" id="playbackBtn" class="small">Phát</button>
              <input id="playbackPosition" type="range" min="0" max="1000" value="0" aria-label="Vị trí mô phỏng theo quãng đường" />
              <span id="playbackStatus" class="tabular-nums"></span>
              <p>Phát nhanh G-code trên web. Máy CNC không di chuyển.</p>
            </div>

            <!-- Viewport Footer: Status & Metrics -->
            <div class="viewport-footer">
              <div class="status-row">
                <div id="convertMsg" class="preview-status" role="status"></div>
                <button type="button" id="retryPreview" class="small ghost hidden">Thử lại</button>
              </div>
              <div id="stats" class="preview-stats tabular-nums" aria-live="polite"></div>
              <p id="printHint" class="compare-legend" hidden></p>
              <p id="compareLegend" class="compare-legend" hidden>Nét xanh là đường bút. Ảnh gốc nằm bên dưới.</p>
            </div>

            <!-- Active Job Quick Monitor (Appears when drawing job is active) -->
            <div id="activeJobBar" class="active-job-bar hidden" role="region" aria-label="Phiên vẽ đang chạy">
              <div class="active-job-info">
                <span class="active-job-pulse" aria-hidden="true"></span>
                <span id="activeJobTitle" class="active-job-title">Đang vẽ</span>
                <span id="activeJobBadge"></span>
              </div>
              <div class="active-job-progress">
                <div class="bar"><span id="activeJobBarFill" style="width: 0%"></span></div>
                <span id="activeJobPercent" class="active-job-pct tabular-nums">0%</span>
              </div>
              <small id="activeJobNotice" class="muted" role="status"></small>
              <div id="activeJobActions" class="active-job-actions"></div>
            </div>
          </section>

          <!-- Right Sidebar Column: Natural Workflow (Settings on Top -> Machine Dispatch Sticky at Bottom) -->
          <aside class="draw-sidebar">
            <!-- Settings Form Panel (Top, independently scrollable) -->
            <section class="card settings-card" aria-labelledby="settingsTitle">
              <form id="convertForm">
                <div class="pane-title pane-title-actions">
                  <h2 id="settingsTitle">Thông số chuyển đổi</h2>
                  <button type="button" id="resetSettings" class="small ghost" title="Khôi phục thông số mặc định">Đặt lại</button>
                </div>
                <div class="pane-body">
                  <!-- Essential Controls with Figma UI3 Recessed Dimensions -->
                  <div class="form-row size-row">
                    <label class="input-field-recessed">
                      <span class="field-prefix">Rộng</span>
                      <input type="number" name="widthMm" value="150" min="10" step="any" required />
                      <span class="field-suffix">mm</span>
                    </label>
                    <label class="input-field-recessed">
                      <span class="field-prefix">Cao</span>
                      <input type="number" name="heightMm" value="150" min="10" step="any" required />
                      <span class="field-suffix">mm</span>
                    </label>
                  </div>
                  <p class="muted option-hint">Giữ tỷ lệ ảnh và căn giữa vùng vẽ của máy.</p>

                  <div class="control-group">
                    <label class="slider-label">
                      <span>Mức chi tiết</span>
                      <output id="detailVal" class="val-pill tabular-nums">5</output>
                    </label>
                    <input type="range" name="detail" min="1" max="10" value="5" />
                    <div class="range-labels muted"><span>Thô (nhanh)</span><span>Chi tiết (kỹ)</span></div>
                  </div>

                  <div class="control-group">
                    <label>Kiểu nét
                      <select name="mode">
                        <option value="centerline">Đường tâm (nét đơn)</option>
                        <option value="outline">Đường viền</option>
                        <option value="fill">Viền và tô gạch</option>
                      </select>
                    </label>
                  </div>

                  <!-- Auto-tune button -->
                  <div class="auto-tune-box">
                    <div class="form-row auto-tune-group" role="group" aria-label="Tìm cấu hình phù hợp">
                      <button type="button" id="autoBtn" class="auto-btn ghost" disabled>Gợi ý cấu hình</button>
                      <button type="button" class="auto-btn ghost" data-tune="fast" aria-label="Tự dò nhanh" disabled>Nhanh</button>
                      <button type="button" class="auto-btn ghost" data-tune="detail" aria-label="Tự dò chi tiết" disabled>Chi tiết</button>
                    </div>
                    <div id="autoResult" class="auto-result" aria-live="polite"></div>
                  </div>

                  <!-- Advanced Accordion -->
                  <details id="advancedOptions" class="advanced-details">
                    <summary>Tùy chọn nâng cao</summary>
                    <div class="advanced-inner">
                      <label>Tách nét nhị phân
                        <select name="thresholdMode">
                          <option value="auto">Tự động (Otsu)</option>
                          <option value="adaptive">Thích nghi ánh sáng</option>
                          <option value="manual">Thủ công</option>
                        </select>
                      </label>
                      <label id="thresholdRow" class="hidden">Ngưỡng tách nét <output id="thresholdVal" class="val-pill tabular-nums">128</output>
                        <input type="range" name="threshold" min="1" max="254" value="128" />
                      </label>
                      <div class="form-row">
                        <label>Làm mượt
                          <select name="smoothing">
                            <option>0</option>
                            <option selected>1</option>
                            <option>2</option>
                            <option>3</option>
                          </select>
                        </label>
                        <label>Đảo màu
                          <select name="invert">
                            <option value="auto">Tự động</option>
                            <option value="false">Không</option>
                            <option value="true">Có</option>
                          </select>
                        </label>
                      </div>
                      <div class="form-row">
                        <label>Dung sai giản lược (mm)
                          <input type="number" name="simplifyMm" placeholder="Tự động" min="0.03" max="1" step="0.01" />
                        </label>
                        <label>Bước gạch / nét bút
                          <input type="number" name="hatchRatio" value="0.9" min="0.6" max="1" step="0.01" required />
                        </label>
                      </div>
                      <div class="form-row">
                        <label>Cách tô
                          <select name="fillStrategy">
                            <option value="legacy">Viền và gạch</option>
                            <option value="inset-x">Tô gạch ngang sát mép trong</option>
                            <option value="inset-y">Tô gạch dọc sát mép trong</option>
                          </select>
                        </label>
                        <label>Độ phân giải dò nét (px)
                          <input type="number" name="rasterPx" placeholder="Tự động" min="210" max="1280" />
                        </label>
                      </div>
                      <label>Bề rộng mực trên giấy (mm)
                        <input type="number" name="penWidthMm" value="0.5" min="0.1" max="3" step="0.01" required />
                      </label>
                      <p class="option-hint muted">0,5 mm là giá trị mô phỏng. Nhập bề rộng mực đo được nếu có.</p>
                      <label class="check">
                        <input type="checkbox" name="despeckle" checked />
                        <span>Lọc đốm nhiễu nhỏ</span>
                      </label>
                      <div class="form-row">
                        <label>Tốc độ vẽ (mm/phút)
                          <input type="number" name="drawFeed" value="1500" min="100" max="10000" required />
                        </label>
                        <label>Chạy không (mm/phút)
                          <input type="number" name="travelFeed" value="3000" min="100" max="10000" required />
                        </label>
                      </div>
                      <div class="form-row">
                        <label>Lệnh nâng bút
                          <input name="penUp" value="M5" pattern="[A-Za-z0-9 .\-]{1,20}" required />
                        </label>
                        <label>Lệnh hạ bút
                          <input name="penDown" value="M3 S90" pattern="[A-Za-z0-9 .\-]{1,20}" required />
                        </label>
                      </div>
                    </div>
                  </details>
                </div>
              </form>
            </section>

            <!-- Machine Dispatch Panel (Sticky / Pinned at bottom) -->
            <section class="card dispatch-card" aria-labelledby="machineTitle">
              <div class="pane-title">
                <h2 id="machineTitle">Máy nhận và lệnh vẽ</h2>
              </div>
              <div class="pane-body">
                <div id="machinePick" class="machine-pick-wrapper"></div>
                <div class="dispatch-actions">
                  <button type="button" class="primary send-btn" id="sendBtn" disabled>Gửi bản vẽ</button>
                  <button type="button" class="ghost download-btn" id="downloadBtn" disabled title="Tải file G-code về máy">
                    Tải G-code
                  </button>
                </div>
                <div id="nextStepGuide" class="step-guide muted">
                  <span id="guideText">Bước 1: Chọn ảnh để bắt đầu.</span>
                </div>
                <p id="draftStatus" class="muted send-status" role="status"></p>
                <button type="button" id="discardDraft" class="small ghost" hidden>Xóa bản nháp</button>
                <p id="sendMsg" class="send-status" role="status"></p>
                <button type="button" id="showSentJob" class="small ghost hidden">Xem trong tab Phiên vẽ</button>
                <details id="gcodeDetails" class="gcode-details hidden">
                  <summary>Mã G-code</summary>
                  <pre id="gcodeText" tabindex="0"></pre>
                </details>
              </div>
            </section>
          </aside>
        </div>
      </div>

      <!-- Tab 2: Job List + Job Control -->
      <div id="tab-jobs" class="tab hidden">
        <div class="page-header">
          <div>
            <h1 class="page-title">Phiên vẽ</h1>
            <p class="muted page-subtitle">Tiến độ và điều khiển các lệnh vẽ trên máy CNC.</p>
          </div>
          <label class="check admin-only">
            <input type="checkbox" id="allJobs" />
            <span>Xem tất cả người dùng</span>
          </label>
        </div>
        <div class="card jobs-card">
          <div class="table-wrap">
            <table class="table jobs-table">
              <thead>
                <tr>
                  <th class="col-id">#</th>
                  <th class="col-name">Bản vẽ</th>
                  <th class="col-mach">Máy vẽ</th>
                  <th class="col-user">Người gửi</th>
                  <th class="col-status">Trạng thái</th>
                  <th class="col-progress">Tiến độ</th>
                  <th class="col-time">Tạo lúc</th>
                  <th class="col-actions">Thao tác</th>
                </tr>
              </thead>
              <tbody id="jobRows"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Tab 3: Machine Cards -->
      <div id="tab-machines" class="tab hidden">
        <div class="page-header">
          <div>
            <h1 class="page-title">Máy vẽ CNC</h1>
            <p class="muted page-subtitle">Trạng thái kết nối MQTT, kích thước vùng làm việc và hàng đợi.</p>
          </div>
        </div>
        <div id="machineCards" class="machine-cards"></div>
      </div>

      <!-- Tab 4: Admin Dashboard -->
      <div id="tab-admin" class="tab hidden">
        <div class="page-header">
          <div>
            <h1 class="page-title">Quản trị hệ thống</h1>
            <p class="muted page-subtitle">Quản lý thiết bị máy vẽ, phân quyền tài khoản và hàng đợi xử lý.</p>
          </div>
        </div>
        <div class="grid-admin">
          <div class="card admin-machines-card">
            <div class="pane-title"><h2>Quản lý máy vẽ</h2></div>
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>Mã máy</th>
                    <th>Tên hiển thị</th>
                    <th>Trạng thái</th>
                    <th>Vùng vẽ (mm)</th>
                    <th>Token MQTT</th>
                    <th>Thao tác</th>
                  </tr>
                </thead>
                <tbody id="admMachines"></tbody>
              </table>
            </div>
            <form id="addMachineForm" class="row inline-form">
              <input name="id" placeholder="Mã máy (vd: cnc-02)" required />
              <input name="name" placeholder="Tên hiển thị" />
              <input name="workWidth" type="number" placeholder="Rộng mm" value="120" min="1" max="120" step="any" />
              <input name="workHeight" type="number" placeholder="Cao mm" value="80" min="1" max="80" step="any" />
              <button class="primary" type="submit">Thêm máy</button>
            </form>
          </div>

          <div class="card admin-users-card">
            <div class="pane-title"><h2>Quản lý người dùng</h2></div>
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Tên tài khoản</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                  </tr>
                </thead>
                <tbody id="admUsers"></tbody>
              </table>
            </div>
            <form id="addUserForm" class="row inline-form">
              <input name="username" placeholder="Tên đăng nhập" required />
              <input name="password" type="password" placeholder="Mật khẩu ≥ 6 ký tự" required />
              <select name="role">
                <option value="user">user</option>
                <option value="admin">admin</option>
              </select>
              <button class="primary" type="submit">Tạo tài khoản</button>
            </form>
          </div>

          <div class="card admin-queue-card">
            <div class="pane-title"><h2>Hàng đợi toàn hệ thống</h2></div>
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Máy</th>
                    <th>Bản vẽ</th>
                    <th>Người gửi</th>
                    <th>Trạng thái</th>
                  </tr>
                </thead>
                <tbody id="admQueue"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </section>

  <!-- Job Details Modal Dialog (Dub/Clerk Vertical Timeline) -->
  <dialog id="jobDetails" aria-labelledby="jobDetailsTitle">
    <div class="dialog-header">
      <h2 id="jobDetailsTitle">Chi tiết phiên vẽ</h2>
      <form method="dialog"><button type="submit" class="small ghost close-btn" aria-label="Đóng">Đóng</button></form>
    </div>
    <div id="jobDetailsBody" class="dialog-body" role="status"></div>
  </dialog>

  <!-- Notification Toast UI (Sonner / Dub Standard) -->
  <div id="toasts" class="toasts" role="status" aria-live="polite"></div>

  <script type="module" src="app.js"></script>
</body>
</html>
